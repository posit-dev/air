{
	"compilerOptions": {
		// Matches `vscode-copilot-chat`'s modern approach. "preserve" is recommended
		// "for code that will be bundled", and we use esbuild to bundle.
		"module": "preserve",
		"moduleResolution": "bundler",
		"noEmit": true,
		"target": "ES2022",
		"lib": ["ES2022"],
		// Global declarations from `@types/*` (e.g. `process`, `suite()`) must
		// be listed explicitly
		"types": ["node", "mocha"],
		// esbuild transpiles files one at a time, so reject code that can't be
		"isolatedModules": true,
		// Enable all strict type-checking options
		"strict": true
	},
	"include": ["src"]
}
