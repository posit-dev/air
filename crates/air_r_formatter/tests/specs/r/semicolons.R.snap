  2
}

# Empty line after lone semicolon is kept
{
  1
  ;

  2
}

# Empty line before leading lone semicolon is removed
{

  ;
  1
}

# Lone semicolon does not add empty line
{
  1
  ;
  2
}

# ------------------------------------------------------------------------
# Comments after a semicolon

1; # c

1 ; # c

# ------------------------------------------------------------------------
# Comment before a lone semicolon

{
  1 # c
  ;
}

{1 # c
;}

# ------------------------------------------------------------------------
