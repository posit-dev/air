{
  1
  ; # c
}

# Leads next statement
{
  ; # c
  1
}

# Dangles
{;# c
}

# ------------------------------------------------------------------------
# Comments around a lone semicolon

# Dangle
{
  # a
  ; # b
  # c
}

# Keep order
{
  1
  # a
  ; # b
  2
}

# ------------------------------------------------------------------------
# Every variant of `handle_empty_statement_comment()`, end of line

{
  1; ; # Trails preceding
  2
}

{
  1; ; ; # Trails preceding
  2
}

{
  1
  ; ; # Leads following
  2
}

{
  1
  ; # Leads following
  2
}

{
  1
  ; # Trails preceding
}

{
  ; # Leads following
  2
}

{
  ; # Dangling on enclosing
}

# ------------------------------------------------------------------------
# Every variant of `handle_empty_statement_comment()`, own line

{
  1
  # Leads following
  ;
  2
}

{
  1
  ;
  # Leads following
  2
}

{
  # Leads following
  ;
  2
}

{
  ;
  # Leads following
  2
}

{
  1
  # Trails preceding
  ;
}

{
  1
  ;
  # Trails preceding
}

{
  # Dangling on enclosing
  ;
}

{
  ;
  # Dangling on enclosing
}

# ------------------------------------------------------------------------
# Function body comment skips semicolons

# Due to `place_leading_or_dangling_body_comment()` finding the first
# non-empy statement, and placing the comment as leading on that.

function() # Leads 1
{
  ;
  1
}

function() # Dangles braces
{;}

function() # Dangles braces
{
  ;
}

# ------------------------------------------------------------------------
# Curly-curly removes semicolon

fn({{ x }; })

fn({{ x; }})

# ------------------------------------------------------------------------
# `# fmt: skip` keeps semicolon

# fmt: skip
x;

```


